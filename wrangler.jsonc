{
  "name": "stag-hunt",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "staghunt-auth",
      "database_id": "127c2688-b764-4aa3-9204-99131cff34c3",
      "migrations_dir": "migrations"
    }
  ],
  // Real-time chat and live updates
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // Cloudflare Email Service (sender must be on the onboarded domain)
  // Workers AI: transcribes recorded founder calls and drafts the deal
  "ai": { "binding": "AI" },
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["login@staghunts.com"] }
  ],
  "vars": {
    "APP_NAME": "Stag Hunt",
    "MAIL_FROM": "login@staghunts.com",
    "GOOGLE_CLIENT_ID": "795415665596-dom1la3kfqa6o9blhumhmlnl0qgeujmp.apps.googleusercontent.com",
    // The AI pitch interviewer on /apply (scripts/interview-agent.mjs). The key is the secret ELEVENLABS_API_KEY.
    // Monthly spending cap in dollars; past it, founders see only the typed form. Raise it to allow more interviews.
    "INTERVIEW_AGENT_ID": "agent_4701m7gzwrnzfyvr786mc8m2xtdj",
    "INTERVIEW_BUDGET_USD": "100",
    // The iPhone app ("Stag Hunt iPhone App" folder). Team ID from developer.apple.com > Membership.
    "APPLE_TEAM_ID": "8S7Q2XFHJ2",
    "APPLE_BUNDLE_ID": "com.staghunts.app",
    // The Android app ("Stag Hunt Android App" folder). Fingerprints of its signing keys, comma separated:
    // the upload key, then Google's app signing key (Play Console > Test and release > App integrity).
    "ANDROID_PACKAGE": "com.staghunts.app",
    "ANDROID_CERT_SHA256": "A4:22:62:36:70:67:BD:DE:CF:F3:8F:EC:F9:E1:34:5D:C6:BA:1D:44:19:EC:DF:31:C6:2B:50:8A:29:CB:EA:F8",
    // Apple's app reviewer signs in here (read-only observer) with the fixed code in the secret REVIEW_CODE.
    "REVIEW_EMAIL": "review@staghunts.com",
    // "on" drafts deals from recorded calls with the Mastra deal workflow (Anthropic via Mastra Gateway),
    // falling back to Workers AI. Needs the secrets MASTRA_URL and MASTRA_SERVER_TOKEN (for wrangler dev, in .dev.vars).
    "DRAFT_VIA_MASTRA": "on",
    // "on" fills /apply applications from the AI interview with the Mastra application workflow (Anthropic via
    // Mastra Gateway), falling back to Workers AI. Same secrets as DRAFT_VIA_MASTRA. Before turning it on, update
    // the "AI pitch interviews" section of public/privacy/ to say interview transcripts go to Anthropic through Mastra.
    "APPLY_VIA_MASTRA": "on",
    // "on" fills the rest of a deal from a recorded call (including how the investor found it and any
    // connection) with the Mastra fill workflow (Anthropic via Mastra Gateway), falling back to Workers AI.
    // Same secrets as DRAFT_VIA_MASTRA.
    "FILL_VIA_MASTRA": "on"
  },
  "routes": [
    { "pattern": "staghunts.com", "custom_domain": true },
    { "pattern": "www.staghunts.com", "custom_domain": true }
  ],
  "workers_dev": false,
  // Weekly digest (Mondays ~9am ET) and monthly backup (1st of the month)
  "triggers": { "crons": ["7 13 * * 1", "17 14 1 * *", "23 4 * * *"] },
  "observability": { "enabled": true }
}
