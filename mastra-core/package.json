{
  "name": "stag-hunt-core",
  "private": true,
  "description": "Stag Hunt's core on the Mastra platform: agents and workflows.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "deploy": "mastra deploy --env production --env-file .env.production --workers in-process --yes",
